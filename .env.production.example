# =============================================
# UAfricas - Variables d'environnement PRODUCTION
# Copier ce fichier en .env et remplir les valeurs
# =============================================

# PostgreSQL
POSTGRES_DB=africans_db
POSTGRES_USER=uafricas
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET
JWT_EXPIRATION_MINUTES=15
REFRESH_EXPIRATION_DAYS=7
RUST_LOG=info

# Frontend
FRONTEND_URL=http://161.97.92.63
NUXT_PUBLIC_API_BASE_URL=/api

# LiveKit (visioconference WebRTC)
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_SECRET

# TURN / coturn (relais pour les appels P2P PeerJS — service "coturn")
# TURN_PUBLIC_IP doit etre l'IP publique du VPS (utilisee par coturn --external-ip
# ET par NUXT_PUBLIC_ICE_SERVERS cote frontend). coturn ecoute sur le port 3479.
# Ouvrir au pare-feu : 3479/udp + 3479/tcp + 49160-49200/udp.
TURN_PUBLIC_IP=161.97.92.63
TURN_USERNAME=uafricas
TURN_PASSWORD=CHANGE_ME_STRONG_TURN_PASSWORD
